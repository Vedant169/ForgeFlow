# ==============================================================================
# ForgeFlow Environment Configuration Template
# Copy this file to .env and configure values before starting Docker or local app
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Security & JWT Authentication (MUST be at least 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key_here
JWT_EXPIRES_IN=24h

# Database Configuration
MONGO_DB=forgeflow
MONGO_PORT=27017
# Internal Docker URI (when running via Docker Compose):
MONGO_URI=mongodb://mongo:27017/forgeflow
# Local development URI (outside Docker):
# MONGO_URI=mongodb://localhost:27017/forgeflow

# CORS Configuration (comma-separated origins allowed to access the backend)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Initial Administrator Credentials for Seeding (npm run seed)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@flowforge.local
ADMIN_PASSWORD=ChangeMeImmediately123!
