# Server Configuration
PORT=5000
NODE_ENV=development

# Security & JWT Authentication
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key_here
JWT_EXPIRES_IN=24h

# Database Configuration
MONGO_URI=mongodb://localhost:27017/etl_pipeline

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Initial Administrator Credentials for Seeding (npm run seed)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@flowforge.local
ADMIN_PASSWORD=ChangeMeImmediately123!
